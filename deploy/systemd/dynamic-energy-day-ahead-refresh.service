[Unit]
Description=Refresh current ENTSO-E and Ecopower Day-Ahead dashboard prices
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/projects/dynamic-energy-dashboard-hermes
EnvironmentFile=-/projects/dynamic-energy-dashboard-hermes/.env
ExecStart=/usr/bin/python3 /projects/dynamic-energy-dashboard-hermes/scripts/build_current_day_ahead_prices.py --fetch --history-days 35 --future-days 2
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
