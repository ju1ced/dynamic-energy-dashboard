[Unit]
Description=Capture next-day read-only prospective shadow-controller plan
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/projects/dynamic-energy-dashboard-hermes
EnvironmentFile=-/projects/dynamic-energy-dashboard-hermes/.env
ExecStartPre=/bin/sh -c 'if [ -n "$ENTSOE_SECURITY_TOKEN" ]; then exec /projects/dynamic-energy-dashboard-hermes/.venv/bin/python /projects/dynamic-energy-dashboard-hermes/scripts/build_current_day_ahead_prices.py --fetch --history-days 35 --future-days 2; fi'
ExecStartPre=/projects/dynamic-energy-dashboard-hermes/.venv/bin/python /projects/dynamic-energy-dashboard-hermes/scripts/refresh_prospective_joint_snapshots.py --soft-fail
ExecStart=/projects/dynamic-energy-dashboard-hermes/.venv/bin/python /projects/dynamic-energy-dashboard-hermes/scripts/capture_prospective_shadow_plan.py
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
