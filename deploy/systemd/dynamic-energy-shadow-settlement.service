[Unit]
Description=Settle previous read-only prospective shadow-controller day
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=4

[Service]
Type=oneshot
WorkingDirectory=/projects/dynamic-energy-dashboard-hermes
ExecStart=/projects/dynamic-energy-dashboard-hermes/.venv/bin/python /projects/dynamic-energy-dashboard-hermes/scripts/capture_prospective_shadow_settlement.py
TimeoutStartSec=10min
Restart=on-failure
RestartSec=15min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
