[Unit]
Description=Refresh Day-Ahead dashboard prices with publication fallbacks

[Timer]
OnCalendar=*-*-* 00:10:00 Europe/Brussels
OnCalendar=*-*-* 13:35:00 Europe/Brussels
OnCalendar=*-*-* 14:50:00 Europe/Brussels
OnCalendar=*-*-* 16:05:00 Europe/Brussels
Persistent=true
RandomizedDelaySec=5m
Unit=dynamic-energy-day-ahead-refresh.service

[Install]
WantedBy=timers.target
